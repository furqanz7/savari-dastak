<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key><string>com.dastak.app.quick.search</string>
			<key>UIApplicationShortcutItemTitle</key><string>Search</string>
			<key>UIApplicationShortcutItemIconSymbolName</key><string>magnifyingglass</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key><string>com.dastak.app.quick.grocery</string>
			<key>UIApplicationShortcutItemTitle</key><string>Grocery</string>
			<key>UIApplicationShortcutItemIconSymbolName</key><string>basket</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key><string>com.dastak.app.quick.food</string>
			<key>UIApplicationShortcutItemTitle</key><string>Food</string>
			<key>UIApplicationShortcutItemIconSymbolName</key><string>fork.knife</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key><string>com.dastak.app.quick.tracking</string>
			<key>UIApplicationShortcutItemTitle</key><string>Track Order</string>
			<key>UIApplicationShortcutItemIconSymbolName</key><string>scooter</string>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>com.dastak.merchant</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MarketplacePrivacyPolicyURL</key>
	<string>$(MARKETPLACE_PRIVACY_POLICY_URL)</string>
	<key>MarketplaceProduct</key>
	<string>$(MARKETPLACE_PRODUCT)</string>
	<key>MarketplaceSupabasePublishableKey</key>
	<string>$(MARKETPLACE_SUPABASE_PUBLISHABLE_KEY)</string>
	<key>MarketplaceSupabaseURL</key>
	<string>$(MARKETPLACE_SUPABASE_URL)</string>
	<key>MarketplaceSupportURL</key>
	<string>$(MARKETPLACE_SUPPORT_URL)</string>
	<key>MarketplaceTermsURL</key>
	<string>$(MARKETPLACE_TERMS_URL)</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Dastak uses your location for delivery addresses. With your permission, approximate location also connects the sign-in scenery to local weather. During an assigned delivery, your precise location is shared with that order’s customer and merchants, including while using another app, until the delivery ends.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
